{
  "name": "hip3",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot": "tsx scripts/snapshot.ts",
    "history": "tsx scripts/history.ts",
    "backfill:zkp2p-liquidity": "tsx scripts/backfill-zkp2p-liquidity.ts",
    "quote:dev": "wrangler dev",
    "quote:deploy": "wrangler deploy",
    "validate": "ajv validate -s schema/product.schema.json -d 'data/products/*.yaml' -c ajv-formats",
    "typecheck": "tsc --noEmit",
    "web:install": "cd web && npm install",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "web:typecheck": "cd web && npm run typecheck",
    "dev": "npm run web:dev"
  },
  "dependencies": {
    "@zkp2p/sdk": "^0.3.0",
    "dotenv": "^17.4.2",
    "viem": "^2.21.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^22.5.0",
    "ajv": "^8.17.0",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.80.0"
  }
}
